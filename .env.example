# Auth (NextAuth.js v5). Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me
# NextAuth v4 name, still read by v5 as a fallback:
NEXTAUTH_SECRET=replace-me
NEXTAUTH_URL=http://localhost:3000

# Datastore. "memory" is the synthetic-data mock (prototype only) and is the default
# outside production; in production it is rejected at startup and "postgres" +
# DATABASE_URL are required.
KYC_DATASTORE=memory
# Point at Supabase/Postgres and implement ReviewsRepository to go live:
# DATABASE_URL=postgresql://postgres:password@db.<project>.supabase.co:5432/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Number of mock KYC reviews seeded at boot
SEED_COUNT=120

# Future integrations (see /api/integrations/aml-check)
# AML_PROVIDER_API_KEY=
# SANCTIONS_PROVIDER_API_KEY=
